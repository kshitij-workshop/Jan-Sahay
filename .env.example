# Government Scheme Assistant - Environment Variables
# Copy this file to .env and fill in actual values
# NEVER commit .env to git

# ===========================================
# DATABASE (MySQL)
# ===========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gov_scheme_assistant
MYSQL_USERNAME=root
MYSQL_PASSWORD=Kshitij@123

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=p8C0KqnzbCJmKzuwfR5j7QI2Ctcf89HXO4r2X0QH7Wu
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# ===========================================
# MYSCHEME.GOV.IN API
# ===========================================
# Get API key from myScheme developer portal
MYSCHEME_API_KEY=tYTy5eEhlu9rFjyxuCr7ra7ACp4dv1RH8gWuHTDc
MYSCHEME_BASE_URL=https://api.myscheme.gov.in

# ===========================================
# SPRING AI (LLM Provider)
# ===========================================
# Options: openai, ollama, azure, etc.
SPRING_AI_PROVIDER=openai
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_MODEL=gpt-4o-mini
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com/v1

# For Ollama (local LLM, no API key needed):
# SPRING_AI_PROVIDER=ollama
# SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
# SPRING_AI_OLLAMA_MODEL=llama3.1

# ===========================================
# WHATSAPP BUSINESS PLATFORM (Meta Cloud API)
# ===========================================
# Get from Meta Developer Console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ===========================================
# DOCUMENT STORAGE
# ===========================================
# Options: local, s3
DOCUMENT_STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# For S3-compatible (MinIO, AWS S3):
# DOCUMENT_STORAGE_TYPE=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=gov-scheme-documents
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ===========================================
# APPLICATION
# ===========================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Limit schemes during development sync
MAX_SYNC_SCHEMES=50

# Enable mock providers for demo (true/false)
USE_MOCK_OCR=true
USE_MOCK_WHATSAPP=true

# ===========================================
# OBSERVABILITY
# ===========================================
LOG_LEVEL=INFO
LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n